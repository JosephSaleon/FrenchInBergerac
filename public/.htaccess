# French in Bergerac – configuration Apache/LiteSpeed (Hostinger)
Options -MultiViews -Indexes
DirectorySlash Off
RewriteEngine On

# 1. Une seule adresse officielle : https://frenchinbergerac.net (sans www)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://frenchinbergerac.net%{REQUEST_URI} [L,R=301]

# 2. Anciennes pages du site Hostinger -> redirection permanente (préserve le référencement)
RewriteRule ^sjours-linguistiques-immersifs--bergerac-pour-apprendre-le-franais-efficacement/?$ / [L,R=301]
RewriteRule ^sjours-linguistiques--bergerac--immersion-dans-la-culture-franaise/?$ / [L,R=301]
RewriteRule ^accueil/?$ / [L,R=301]
RewriteRule ^sitemap.xml$ /sitemap-index.xml [L,R=301]

# 3. URLs propres : /index.html -> /, /contact.html -> /contact, /contact/ -> /contact
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?]
RewriteRule ^ /%1 [L,R=301]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?]
RewriteRule ^ /%1 [L,R=301]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [L,R=301]

# 4. Sert le fichier .html correspondant (/contact -> contact.html, /en -> en.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html

# 5. Cache navigateur : les fichiers de /_astro ont un nom unique, on peut les garder 1 an
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|avif|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
