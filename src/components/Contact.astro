---
import { ROUTES, type Lang } from '../config';
import { t } from '../i18n';
import { getContact, getSeo, CONTACT } from '../site-content';
import Base from '../layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const f = d.contact.form;
const page = getContact(lang);
const seo = getSeo(lang).contact;
---

<Base lang={lang} route="contact" title={seo.title} description={seo.description}>
  <section class="section contact">
    <div class="wrap contact-grid">
      <div>
        <h1>{page.title}</h1>
        <p class="lead">{page.lead}</p>
        <div class="contact-card">
          <h2 class="h3">{d.contact.direct}</h2>
          <dl>
            <dt>{d.contact.phone}</dt>
            <dd><a href={`tel:${CONTACT.phoneIntl}`}>{lang === 'fr' ? CONTACT.phone : CONTACT.phoneIntlDisplay}</a></dd>
            <dt>{d.contact.email}</dt>
            <dd><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd>
            <dt>{d.contact.address}</dt>
            <dd>{CONTACT.street}<br />{CONTACT.postalCode} {CONTACT.city}, France</dd>
          </dl>
        </div>
      </div>

      <!-- Netlify Forms : détecté au déploiement, les demandes arrivent dans Netlify et par e-mail -->
      <form
        class="contact-form"
        name="contact"
        method="POST"
        action={ROUTES.thanks[lang]}
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="subject" value={f.subject} />
        <input type="hidden" name="langue" value={lang} />
        <label class="hp" aria-hidden="true">Ne pas remplir <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        <label>
          <span>{f.name}</span>
          <input type="text" name="name" autocomplete="given-name" />
        </label>
        <label>
          <span>{f.email} <abbr title={f.required}>*</abbr></span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <div class="form-row">
          <label>
            <span>{f.dates}</span>
            <input type="text" name="dates" placeholder={f.datesPlaceholder} />
          </label>
          <label>
            <span>{f.level}</span>
            <select name="level">
              {f.levels.map((l) => <option>{l}</option>)}
            </select>
          </label>
        </div>
        <label>
          <span>{f.message} <abbr title={f.required}>*</abbr></span>
          <textarea name="message" rows="6" required></textarea>
        </label>
        <button class="btn" type="submit">{f.submit}</button>
      </form>
    </div>
  </section>
</Base>
