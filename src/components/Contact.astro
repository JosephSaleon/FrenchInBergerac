---
import { SITE, ROUTES, type Lang } from '../config';
import { t } from '../i18n';
import Base from '../layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const f = d.contact.form;
const thanksUrl = new URL(ROUTES.thanks[lang], SITE.url).href;
// Sans clé Web3Forms, le formulaire ouvre la messagerie du visiteur (solution de secours)
const hasKey = SITE.web3formsKey.length > 0;
---

<Base lang={lang} route="contact" title={d.meta.contactTitle} description={d.meta.contactDescription}>
  <section class="section contact">
    <div class="wrap contact-grid">
      <div>
        <h1>{d.contact.title}</h1>
        <p class="lead">{d.contact.lead}</p>
        <div class="contact-card">
          <h2 class="h3">{d.contact.direct}</h2>
          <dl>
            <dt>{d.contact.phone}</dt>
            <dd><a href={`tel:${SITE.phoneIntl}`}>{lang === 'fr' ? SITE.phoneDisplay : '+33 6 74 60 78 19'}</a></dd>
            <dt>{d.contact.email}</dt>
            <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
            <dt>{d.contact.address}</dt>
            <dd>{SITE.street}<br />{SITE.postalCode} {SITE.city}, France</dd>
          </dl>
        </div>
      </div>

      <form
        class="contact-form"
        method="POST"
        action={hasKey ? 'https://api.web3forms.com/submit' : `mailto:${SITE.email}`}
        enctype={hasKey ? undefined : 'text/plain'}
      >
        {hasKey && (
          <>
            <input type="hidden" name="access_key" value={SITE.web3formsKey} />
            <input type="hidden" name="subject" value={f.subject} />
            <input type="hidden" name="from_name" value={SITE.name} />
            <input type="hidden" name="redirect" value={thanksUrl} />
            <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          </>
        )}
        <label>
          <span>{f.name}</span>
          <input type="text" name="name" autocomplete="given-name" />
        </label>
        <label>
          <span>{f.email} <abbr title={f.required}>*</abbr></span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <div class="form-row">
          <label>
            <span>{f.dates}</span>
            <input type="text" name="dates" placeholder={f.datesPlaceholder} />
          </label>
          <label>
            <span>{f.level}</span>
            <select name="level">
              {f.levels.map((l) => <option>{l}</option>)}
            </select>
          </label>
        </div>
        <label>
          <span>{f.message} <abbr title={f.required}>*</abbr></span>
          <textarea name="message" rows="6" required></textarea>
        </label>
        <button class="btn" type="submit">{f.submit}</button>
      </form>
    </div>
  </section>
</Base>
