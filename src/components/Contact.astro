---
import { CONTACT_FORM, ROUTES, SITE, type Lang } from '../config';
import { t } from '../i18n';
import { getContact, getSeo, CONTACT } from '../site-content';
import Base from '../layouts/Base.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
if (!CONTACT_FORM.accessKey) console.warn('[contact] clé Web3Forms manquante (src/config.ts) : le formulaire ne peut pas envoyer');
// page de remerciement sur le vrai domaine ; le script ci-dessous la remplace par celle du domaine
// courant, pour que le formulaire fonctionne aussi sur l'adresse provisoire
const thanksUrl = new URL(ROUTES.thanks[lang], SITE.url).href;
const f = d.contact.form;
const page = getContact(lang);
const seo = getSeo(lang).contact;
---

<Base lang={lang} route="contact" title={seo.title} description={seo.description}>
  <section class="section contact">
    <div class="wrap contact-grid">
      <div>
        <h1>{page.title}</h1>
        <p class="lead">{page.lead}</p>
        <div class="contact-card">
          <h2 class="h3">{d.contact.direct}</h2>
          <dl>
            <dt>{d.contact.phone}</dt>
            <dd><a href={`tel:${CONTACT.phoneIntl}`}>{lang === 'fr' ? CONTACT.phone : CONTACT.phoneIntlDisplay}</a></dd>
            <dt>{d.contact.email}</dt>
            <dd><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd>
            <dt>{d.contact.address}</dt>
            <dd>{CONTACT.street}<br />{CONTACT.postalCode} {CONTACT.city}, France</dd>
          </dl>
        </div>
      </div>

      <!-- Web3Forms (voir CONTACT_FORM dans src/config.ts) : la demande part par e-mail, puis le
           visiteur est renvoyé sur la page de remerciement -->
      <form class="contact-form" method="POST" action={CONTACT_FORM.endpoint}>
        <input type="hidden" name="access_key" value={CONTACT_FORM.accessKey} />
        <input type="hidden" name="subject" value={f.subject} />
        <input type="hidden" name="from_name" value={SITE.name} />
        <input type="hidden" name="redirect" value={thanksUrl} data-path={ROUTES.thanks[lang]} />
        <input type="hidden" name="langue" value={lang} />
        <label class="hp" aria-hidden="true">Ne pas remplir <input type="checkbox" name="botcheck" tabindex="-1" /></label>
        <label>
          <span>{f.name}</span>
          <input type="text" name="name" autocomplete="given-name" />
        </label>
        <label>
          <span>{f.email} <abbr title={f.required}>*</abbr></span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <div class="form-row">
          <label>
            <span>{f.dates}</span>
            <input type="text" name="dates" placeholder={f.datesPlaceholder} />
          </label>
          <label>
            <span>{f.level}</span>
            <select name="level">
              {f.levels.map((l) => <option>{l}</option>)}
            </select>
          </label>
        </div>
        <label>
          <span>{f.message} <abbr title={f.required}>*</abbr></span>
          <textarea name="message" rows="6" required></textarea>
        </label>
        <button class="btn" type="submit">{f.submit}</button>
      </form>
      <script is:inline>
        document.querySelectorAll('input[name="redirect"][data-path]').forEach((i) => (i.value = location.origin + i.dataset.path));
      </script>
    </div>
  </section>
</Base>
