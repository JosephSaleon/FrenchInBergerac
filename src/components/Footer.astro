---
import { SITE, ROUTES, type Lang } from '../config';
import { t } from '../i18n';
import { getPosts } from '../blog';
import { CONTACT } from '../site-content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
// Le menu du haut est masqué sur mobile : le blog est aussi accessible ici
const hasPosts = (await getPosts(lang)).length > 0;
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <p class="footer-brand">French <em>in</em> Bergerac</p>
      <p class="footer-tagline">{d.footer.tagline}</p>
    </div>
    <address>
      {CONTACT.street}<br />
      {CONTACT.postalCode} {CONTACT.city}, France<br />
      <a href={`tel:${CONTACT.phoneIntl}`}>{CONTACT.phone}</a><br />
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
    </address>
    <nav aria-label={lang === 'fr' ? 'Langues' : 'Languages'} class="footer-langs">
      <a href={ROUTES.home.fr} hreflang="fr" lang="fr" aria-current={lang === 'fr' ? 'true' : undefined}>Français</a>
      <a href={ROUTES.home.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>English</a>
      {hasPosts && <a class="footer-blog" href={ROUTES.blog[lang]}>{d.nav.blog}</a>}
    </nav>
  </div>
  <p class="wrap footer-legal">© {new Date().getFullYear()} {SITE.name}</p>
</footer>
