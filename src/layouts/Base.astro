---
import '@fontsource/young-serif/latin-400.css';
import '@fontsource-variable/figtree/wght.css';
import '../styles/global.css';
import { SITE, ROUTES, type Lang, type RouteKey } from '../config';
import { t } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangBanner from '../components/LangBanner.astro';

interface Props {
  lang: Lang;
  route?: RouteKey;
  title: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: object[];
}

const { lang, route, title, description, noindex = false, jsonLd = [] } = Astro.props;
const d = t(lang);
const canonical = new URL(route ? ROUTES[route][lang] : Astro.url.pathname, SITE.url).href;
const alternates = route
  ? [
      { hreflang: 'fr', href: new URL(ROUTES[route].fr, SITE.url).href },
      { hreflang: 'en', href: new URL(ROUTES[route].en, SITE.url).href },
      // Les visiteurs non francophones sont la cible principale : l'anglais sert de version par défaut
      { hreflang: 'x-default', href: new URL(ROUTES[route].en, SITE.url).href },
    ]
  : [];
const ogImage = new URL('/og-image.jpg', SITE.url).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_GB' : 'fr_FR'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5eee1" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{d.skip}</a>
    {route && <LangBanner lang={lang} route={route} />}
    <Header lang={lang} route={route} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
