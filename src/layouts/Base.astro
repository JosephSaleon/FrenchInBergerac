---
import '@fontsource/young-serif/latin-400.css';
import '@fontsource-variable/figtree/wght.css';
import '../styles/global.css';
import { SITE, ROUTES, type Lang, type Paths, type RouteKey } from '../config';
import { t } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangBanner from '../components/LangBanner.astro';

interface Props {
  lang: Lang;
  route?: RouteKey;
  /** à la place de route, pour les pages dynamiques (articles du blog) */
  paths?: Paths;
  title: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: object[];
  /** image de partage propre à la page (sinon og-image.jpg) */
  image?: { src: string; width: number; height: number; alt: string };
  ogType?: 'website' | 'article';
}

const { lang, route, title, description, jsonLd = [], ogType = 'website' } = Astro.props;
// Aperçu ou site pas encore sur son domaine : jamais indexé (voir astro.config.mjs)
const noindex = Astro.props.noindex || __NOINDEX__;
const d = t(lang);
const paths: Paths | undefined = route ? ROUTES[route] : Astro.props.paths;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const otherPath = paths?.[other];
const abs = (path: string) => new URL(path, SITE.url).href;
const canonical = abs(paths?.[lang] ?? Astro.url.pathname);
// hreflang seulement si la page existe dans les deux langues
const alternates =
  paths?.fr && paths.en
    ? [
        { hreflang: 'fr', href: abs(paths.fr) },
        { hreflang: 'en', href: abs(paths.en) },
        // Les visiteurs non francophones sont la cible principale : l'anglais sert de version par défaut
        { hreflang: 'x-default', href: abs(paths.en) },
      ]
    : [];
const og = Astro.props.image
  ? { ...Astro.props.image, src: abs(Astro.props.image.src) }
  : { src: abs('/og-image.jpg'), width: 1200, height: 630, alt: d.meta.ogAlt };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    {otherPath && <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_GB' : 'fr_FR'} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={og.src} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5eee1" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{d.skip}</a>
    {otherPath && <LangBanner lang={lang} otherHref={otherPath} />}
    <Header lang={lang} otherHref={otherPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
